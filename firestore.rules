rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/studioUsers/$(request.auth.uid)).data.role;
    }

    function canReadStudio() {
      return signedIn() && role() in ['designer', 'reviewer', 'admin'];
    }

    function canEditStudio() {
      return signedIn() && role() in ['designer', 'admin'];
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    // Role records are administered only from the Firebase Console or a trusted server.
    match /studioUsers/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /sduiScreens/{screenId} {
      allow read: if canReadStudio();
      allow create, update: if canEditStudio();
      allow delete: if isAdmin();

      // Versions are append-only. An accidental edit cannot silently rewrite history.
      match /versions/{versionId} {
        allow read: if canReadStudio();
        allow create: if canEditStudio();
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
  }
}

