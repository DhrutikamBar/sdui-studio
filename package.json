{
  "name": "flexflow-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/all.test.mjs",
    "test:e2e": "npx --yes firebase-tools@15.30.1 emulators:exec --project demo-flexflow-ui --only auth,firestore \"node scripts/seed-e2e.mjs && playwright test\"",
    "lint": "npm run typecheck",
    "typecheck:plugin": "tsc -p figma-plugin/tsconfig.json --noEmit",
    "build:plugin": "node scripts/build-figma-plugin.mjs"
  },
  "dependencies": {
    "firebase": "12.18.0",
    "firebase-admin": "14.4.0",
    "next": "15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.118.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "esbuild": "0.25.9",
    "typescript": "5.8.3"
  }
}
